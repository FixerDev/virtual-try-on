# --- Supabase ---
# Project URL + anon key from: https://supabase.com/dashboard/project/<id>/settings/api
# Run `supabase/schema.sql` in the Supabase SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# --- fal.ai ---
# API key from: https://fal.ai/dashboard/keys
FAL_KEY=your_fal_key_here

# Optional: override the virtual try-on endpoint.
# Default: fal-ai/flux-2-lora-gallery/virtual-tryon (prompt-based, ~$0.02-0.04)
#   - fal-ai/fashn/tryon/v1.6                (category-based, high quality)
#   - fal-ai/image-apps-v2/virtual-try-on    (no prompt support)
# FAL_TRYON_ENDPOINT=fal-ai/flux-2-lora-gallery/virtual-tryon
